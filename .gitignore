# secrets — nothing credential-shaped is ever committed
.env
.env.*
*.pem
*.key
neardev/
.near-credentials/
.local/

# build output
node_modules/
target/
*.wasm
dist/

# ...except the pinned copy of the wasm actually running on testnet, which the
# migration test deploys so that it migrates the code that is running rather
# than a fresh build of it. The blanket rule above hides it silently, and a
# test fixture that is not in the repository is a test nobody else can run.
!contracts/integration/fixtures/*.wasm

# os / editor
.DS_Store
*.swp
