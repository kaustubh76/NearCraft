{
  "note": "Every Minecraft artifact this repository downloads, pinned by content hash. Nothing is vendored: the jars are fetched into .tmp/ and verified before use, so a clone stays small and a tampered mirror is caught rather than compiled against. The server build and the API build are the SAME build (26.3 build 231), so the plugin is compiled against exactly the server it is tested on.",
  "java": {
    "minimum": 25,
    "install": "brew install openjdk@25",
    "home": "/opt/homebrew/opt/openjdk@25",
    "why": "Paper 26.3 refuses to start on anything older. macOS ships a /usr/bin/java stub that is not a JVM at all, so this path is used explicitly rather than trusting PATH."
  },
  "compileClasspath": [
    "paper-api",
    "adventure-key",
    "adventure-api",
    "annotations",
    "jspecify",
    "checker-qual",
    "guava",
    "bungeecord-chat"
  ],
  "artifacts": {
    "paper-api": {
      "version": "26.3.build.231-stable",
      "sha256": "f0df9e7faccd38fabcdf4d2e6a243649cabc11f0a19fec100b43d7357369fb22",
      "url": "https://repo.papermc.io/repository/maven-public/io/papermc/paper/paper-api/26.3.build.231-stable/paper-api-26.3.build.231-stable.jar",
      "use": "compile only"
    },
    "adventure-key": {
      "version": "5.2.0",
